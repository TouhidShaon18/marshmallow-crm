// Marshmallow CRM — database schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER      // "Super Admin" — full access incl. API keys & integrations
  ADMIN      // full operational access EXCEPT API keys & integrations (Settings)
  MANAGER    // Sales & Marketing Manager — full Sales + Marketing (+ their people); no Finance/Settings
  EMPLOYEE   // legacy — treated as SALES
  SALES
  MARKETING
  FINANCE
}

enum Channel {
  ONLINE
  OFFLINE
}

enum InteractionType {
  WHATSAPP
  EMAIL
  SMS
  CALL
  NOTE
}

// Promotional broadcast channels (1-to-many). WhatsApp stays 1-to-1, not here.
enum BroadcastChannel {
  SMS
  EMAIL
}

enum BroadcastStatus {
  DRAFT
  SCHEDULED
  SENT
}

// Pipeline stages a customer moves through.
enum Stage {
  NEW_LEAD
  CONTACTED
  INTERESTED
  PURCHASED
  REPEAT
  LOST
}

// What a follow-up step / task is for.
enum TaskChannel {
  WHATSAPP
  EMAIL
  CALL
  TASK
}

enum TaskStatus {
  PENDING
  DONE
  SKIPPED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

// Social media channels for the planner.
enum SocialChannel {
  FACEBOOK
  INSTAGRAM
  YOUTUBE
  GMB
  REDDIT
  PINTEREST
  TIKTOK
  BLOG
  EMAIL
  SMS
  INFLUENCER
}

// Lifecycle of a planned social post.
enum PostStatus {
  PLANNED
  POSTED
  METRICS_LOGGED
}

// What kicks off an automation.
enum WorkflowTrigger {
  CUSTOMER_CREATED // when a new customer is added
  STAGE_CHANGED    // when a customer moves to a stage
  BIRTHDAY_SOON    // N days before a customer's birthday
  NO_CONTACT       // not contacted in N days (win-back)
}

// What the automation does.
enum WorkflowAction {
  ENROLL_SEQUENCE
  CREATE_TASK
}

model User {
  id           String           @id @default(cuid())
  name         String
  email        String           @unique
  passwordHash String
  role         Role             @default(EMPLOYEE)
  // Which department sections a (non-elevated) user can access: SALES / MARKETING / FINANCE.
  // Owner/Admin/Manager get access from their role; this drives staff with custom combos.
  departments  String[]         @default([])
  createdAt    DateTime         @default(now())

  customers        Customer[]        @relation("AssignedCustomers")
  interactions     Interaction[]
  tasks            Task[]
  targets          EmployeeTarget[]
  socialTemplates  SocialTemplate[]
  socialPosts      SocialPost[]
}

// Monthly targets set by the owner for each employee.
model EmployeeTarget {
  id                   String   @id @default(cuid())
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId               String
  period               String   // "YYYY-MM" e.g. "2026-06"
  // ── Sales targets ────────────────────────────────────────────────────────
  revenueTarget        Float?   // ৳ total revenue
  contactTarget        Int?     // total interactions logged
  followup7dTarget     Int?     // customers followed up within 7 days of creation
  followup30dTarget    Int?     // customers followed up within 30 days of creation
  convertedSaleTarget  Int?     // customers with orderAmount > 0 contacted this month
  repeatSaleTarget     Int?     // repeat customers contacted this month
  newCustomerTarget    Int?     // new customers added/assigned

  // ── Marketing targets ────────────────────────────────────────────────────
  postsTarget          Int?     // social posts published
  viewsTarget          Int?     // total views across all platforms
  reactsTarget         Int?     // total reactions / likes
  commentsTarget       Int?     // total comments
  sharesTarget         Int?     // total shares / reposts

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([userId, period])
}

model Customer {
  id              String        @id @default(cuid())
  name            String
  address         String?
  favouriteAnime  String?
  whatsappNumber  String?
  email           String?
  productBought   String?
  channel         Channel       @default(OFFLINE)
  giftReceived    String?
  // extra fields requested
  birthday        DateTime?
  orderAmount     Float?
  repeatCustomer  Boolean       @default(false)

  assignedTo      User?         @relation("AssignedCustomers", fields: [assignedToId], references: [id])
  assignedToId    String?

  leadSource      String?       // Instagram, TikTok, Facebook, Referral, Walk-in, Online, Other, Nuport
  nuportId        String?       @unique  // Nuport customer ID — set on auto-synced records

  stage           Stage         @default(NEW_LEAD)
  lastContactedAt DateTime?
  purchasedAt     DateTime?     // set when stage first moves to PURCHASED
  reviewSmsSentAt DateTime?     // set when the GMB review SMS fires (3 days after purchasedAt)

  // ── Guild loyalty card ───────────────────────────────────────────────────
  stampCount              Int       @default(0)
  hokageRewardClaimed     Boolean   @default(false)  // stamp 5: 10% off up to ৳1,000
  pirateKingRewardClaimed Boolean   @default(false)  // stamp 10: gift item OR 50% off
  pirateKingRewardItem    String?   // which gift item was chosen at stamp 10

  createdAt       DateTime      @default(now())

  interactions    Interaction[]
  enrollments     Enrollment[]
  tasks           Task[]
  tags            Tag[]
}

// Key-value store for app-level settings (Nuport API key, last sync time, etc.)
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// GHL-style customer tags (many-to-many).
model Tag {
  id        String     @id @default(cuid())
  name      String     @unique
  color     String     @default("purple")
  createdAt DateTime   @default(now())
  customers Customer[]
}

// A reusable follow-up sequence (like a GHL campaign/workflow).
model Sequence {
  id          String         @id @default(cuid())
  name        String
  description String?
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())

  steps       SequenceStep[]
  enrollments Enrollment[]
}

// One timed step within a sequence.
model SequenceStep {
  id         String      @id @default(cuid())
  sequence   Sequence    @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  sequenceId String
  order      Int         // 1, 2, 3 …
  dayOffset  Int         // days after enrollment this step is due
  channel    TaskChannel @default(WHATSAPP)
  title      String
  message    String?     // template, supports {name} {anime} {product}

  tasks      Task[]
}

// A customer enrolled into a sequence.
model Enrollment {
  id         String           @id @default(cuid())
  customer   Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  sequence   Sequence         @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  sequenceId String
  status     EnrollmentStatus @default(ACTIVE)
  startedAt  DateTime         @default(now())
  workflowId String?          // set if created by an automation

  tasks      Task[]
}

// A trigger-based automation (GoHighLevel-style workflow).
model Workflow {
  id               String          @id @default(cuid())
  name             String
  active           Boolean         @default(true)
  trigger          WorkflowTrigger

  // trigger config (only the relevant one is used)
  triggerStage     Stage?          // for STAGE_CHANGED (null = any stage)
  daysBefore       Int?            // for BIRTHDAY_SOON
  inactivityDays   Int?            // for NO_CONTACT

  // action config
  action           WorkflowAction
  actionSequenceId String?         // for ENROLL_SEQUENCE
  taskChannel      TaskChannel?    // for CREATE_TASK
  taskTitle        String?
  taskMessage      String?

  lastRunAt        DateTime?       // for time-based triggers (once-daily guard)
  createdAt        DateTime        @default(now())
}

// A promotional broadcast (SMS or Email) — planned/tracked here, sent externally.
model Broadcast {
  id                   String           @id @default(cuid())
  channel              BroadcastChannel
  name                 String
  subject              String?          // email only
  message              String
  // audience filters (all optional; null = no filter on that field)
  filterStage          Stage?
  filterAnime          String?
  filterPurchaseChannel Channel?
  filterRepeatOnly     Boolean          @default(false)
  filterTagId          String?

  recipientCount       Int              @default(0)
  status               BroadcastStatus  @default(DRAFT)
  scheduledFor         DateTime?
  sentAt               DateTime?
  createdById          String?
  createdAt            DateTime         @default(now())
}

// An actionable follow-up reminder (the thing staff act on each day).
model Task {
  id           String        @id @default(cuid())
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId   String
  enrollment   Enrollment?   @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  enrollmentId String?
  step         SequenceStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)
  stepId       String?
  assignedTo   User?         @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedToId String?

  channel      TaskChannel   @default(TASK)
  title        String
  message      String?       // pre-filled message (merge fields already resolved)
  dueAt        DateTime
  workflowId   String?       // set if created by an automation
  status       TaskStatus    @default(PENDING)
  completedAt  DateTime?
  createdAt    DateTime      @default(now())
}

model Interaction {
  id         String          @id @default(cuid())
  customer   Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  employee   User?           @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  employeeId String?
  type       InteractionType @default(NOTE)
  summary    String
  createdAt  DateTime        @default(now())
}

// Recurring social post template — defines what to post, where, and which day each month.
model SocialTemplate {
  id           String        @id @default(cuid())
  channel      SocialChannel
  topic        String        // post idea / content theme
  notes        String?       // caption hints, hashtags, etc.
  frequency    String        @default("MONTHLY") // MONTHLY | WEEKLY | BIWEEKLY | DAILY
  dayOfMonth   Int           // 1–31 (clamped); used by MONTHLY
  dayOfWeek    Int?          // 0=Sun … 6=Sat; used by WEEKLY / BIWEEKLY
  postHour     Int           @default(9)  // 0–23, scheduled time hour
  postMinute   Int           @default(0)  // 0–59
  assignedTo   User?         @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedToId String?
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  posts        SocialPost[]
}

// One instance of a planned post for a specific month.
model SocialPost {
  id            String          @id @default(cuid())
  template      SocialTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateId    String?

  channel       SocialChannel
  topic         String
  notes         String?
  period        String          // "YYYY-MM"
  scheduledDate DateTime

  assignedTo    User?           @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedToId  String?

  // Post log
  status        PostStatus      @default(PLANNED)
  postedAt      DateTime?
  postUrl       String?

  // Performance metrics
  reactCount    Int?
  viewCount     Int?
  commentCount  Int?
  shareCount    Int?
  metricsLoggedAt         DateTime?
  metricsReminderSentAt   DateTime? // set by cron 3 days after posting

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

// Marketing campaign tracker.
model Campaign {
  id        String    @id @default(cuid())
  name      String
  channel   String    // Instagram, TikTok, Facebook, SMS, Email, Flyer, etc.
  budget    Float?
  startDate DateTime?
  endDate   DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  influencerDeals InfluencerDeal[]
}

// ── Influencer management ────────────────────────────────────────────────────

enum InfluencerPlatform {
  INSTAGRAM
  TIKTOK
  YOUTUBE
  FACEBOOK
  TWITTER
  BLOG
  OTHER
}

// An influencer profile (person / channel).
model Influencer {
  id            String              @id @default(cuid())
  name          String
  socialHandle  String              // @username or channel name
  platform      InfluencerPlatform  @default(INSTAGRAM)
  followerCount Int?
  email         String?
  phone         String?
  niche         String?             // fashion, tech, anime, gaming, etc.
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  deals         InfluencerDeal[]
}

// One paid deal / collaboration with an influencer.
model InfluencerDeal {
  id            String      @id @default(cuid())
  influencer    Influencer  @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  influencerId  String

  // Optional link to a Campaign
  campaign      Campaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  campaignId    String?

  title         String      // what the deal was for (e.g. "Ramadan promo reel")
  startDate     DateTime?
  endDate       DateTime?

  // Payment
  amountPaid    Float?      // ৳ paid to influencer
  paymentNotes  String?     // bank transfer ref, bKash, etc.

  // Performance
  reach         Int?        // estimated reach / impressions
  interactions  Int?        // total engagements (likes + comments + shares)
  clicks        Int?        // link clicks / swipe-ups
  conversions   Int?        // sales / signups attributed to this deal

  postUrl       String?     // link to the actual post
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// ── Finance module ────────────────────────────────────────────────────────────

// Granularity a P&L entry can be logged at.
enum FinancePeriodType {
  DAILY    // period = "YYYY-MM-DD"
  WEEKLY   // period = "YYYY-Www" (ISO week)
  MONTHLY  // period = "YYYY-MM"
}

// P&L entry — bookkeeper fills this in daily, weekly, or monthly.
model FinanceEntry {
  id         String            @id @default(cuid())
  periodType FinancePeriodType @default(MONTHLY)
  period     String            // format depends on periodType

  // Revenue
  revenue           Float @default(0)

  // COGS breakdown
  cogsRawMaterials  Float @default(0)
  cogsLabour        Float @default(0)
  cogsPackaging     Float @default(0)
  cogsDirectProd    Float @default(0)
  cogsMisc          Float @default(0)

  // Operating Expenses — Fixed
  opexRent          Float @default(0)
  opexSalaries      Float @default(0)
  opexSubscriptions Float @default(0)

  // Operating Expenses — Variable
  // opexUtilities / opexMarketing hold the TOTAL; the *Items columns hold the
  // itemized breakdown as JSON: [{ "label": string, "amount": number }, …]
  opexUtilities      Float @default(0)
  opexUtilitiesItems Json?
  opexMarketing      Float @default(0)
  opexMarketingItems Json?
  opexLogistics      Float @default(0)
  opexMiscVar        Float @default(0)

  // Tax + interest (deducted after EBIT to get Net Profit)
  taxAndInterest    Float @default(0)

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([periodType, period])
}

// Monthly financial goals — set by the owner.
model FinanceGoal {
  id      String @id @default(cuid())
  period  String @unique  // "YYYY-MM"

  revenueTarget     Float?
  netProfitTarget   Float?
  grossMarginTarget Float?   // percentage, e.g. 40 = 40%
  opexBudget        Float?
  marketingBudget   Float?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Affiliate marketing ─────────────────────────────────────────────────────

// Global commission tiers by order-value bracket (admin-set defaults).
model CommissionTier {
  id        String  @id @default(cuid())
  category  String  @default("General") // product category; "General" = fallback for any category
  label     String  // e.g. "Under 3k", "3k-10k"
  minAmount Float    @default(0)  // inclusive lower bound
  maxAmount Float?               // exclusive upper bound; null = no cap (e.g. 100k+)
  percent   Float                // default commission %
  sort      Int      @default(0) // display order
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  overrides AffiliateCommissionOverride[]
}

// A creator/affiliate we collaborate with, identified by a coupon code.
model Affiliate {
  id           String   @id @default(cuid())
  name         String
  couponCode   String   @unique
  platform     String?  // Instagram, TikTok, YouTube, Facebook, etc.
  socialHandle String?
  phone        String?
  email        String?
  notes        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  overrides AffiliateCommissionOverride[]
  sales     AffiliateSale[]
  payouts   AffiliatePayout[]
}

// Per-creator override of a tier's commission % (negotiated rate).
model AffiliateCommissionOverride {
  id          String         @id @default(cuid())
  affiliate   Affiliate      @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  affiliateId String
  tier        CommissionTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  tierId      String
  percent     Float

  @@unique([affiliateId, tierId])
}

// One coupon-attributed sale, with a snapshot of the commission calc.
model AffiliateSale {
  id          String    @id @default(cuid())
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  affiliateId String

  orderAmount Float
  orderRef    String?   // invoice / order number
  productName String?
  category    String?   // product category used to pick the commission tier
  externalId  String?   @unique // e.g. "woo-{orderId}-{lineId}" — dedupes auto-synced rows
  soldAt      DateTime  @default(now())

  // Snapshot at entry time so later tier edits don't rewrite history.
  tierLabel   String
  percent     Float
  commission  Float

  paid        Boolean          @default(false)
  paidAt      DateTime?
  payout      AffiliatePayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  payoutId    String?

  createdAt   DateTime  @default(now())

  @@index([affiliateId])
}

// A payout to a creator that settles a batch of unpaid commissions.
model AffiliatePayout {
  id          String    @id @default(cuid())
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  affiliateId String
  amount      Float
  method      String?   // bKash, bank transfer, cash, etc.
  reference   String?
  note        String?
  paidAt      DateTime  @default(now())
  createdAt   DateTime  @default(now())

  sales AffiliateSale[]

  @@index([affiliateId])
}

// Maps a social channel to the employee who owns it (bulk assignment).
model ChannelAssignment {
  id           String   @id @default(cuid())
  channel      String   @unique // SocialChannel value, e.g. "INSTAGRAM"
  assignedToId String?
  updatedAt    DateTime @updatedAt
}
