# Copy to .env and fill in. See DEPLOY.md for production setup.

# Local dev uses SQLite. In production (Vercel + Neon), set this to your
# Neon Postgres connection string AND change schema.prisma provider to "postgresql".
DATABASE_URL="file:./dev.db"

# Session signing secret — use any long random string in production.
AUTH_SECRET="change-me-to-a-long-random-string"

# Protects the daily scheduler endpoint (/api/cron/run-automations).
# Leave blank locally; set a long random string in production (Vercel signs cron calls with it).
CRON_SECRET=""

# Email (Resend). Leave RESEND_API_KEY blank to run in "console mode" (logs instead of sends).
RESEND_API_KEY=""
EMAIL_FROM="Marshmallow CRM <onboarding@resend.dev>"

# SMS (BulkSMSBD). Leave blank to run in "console mode" (logs instead of sends).
# Get your API key from: https://bulksmsbd.net (Account → API)
# BULKSMSBD_SENDER_ID is required — use your assigned numeric ID for non-masking SMS,
# or your approved text name for masking SMS.
BULKSMSBD_API_KEY=""
BULKSMSBD_SENDER_ID=""
